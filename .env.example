# ─── Postgres ───
POSTGRES_USER=finsight_user
POSTGRES_PASSWORD=finsight_password
POSTGRES_DB=finsight_db

# ─── Redis ───
REDIS_HOST=finsight-redis
REDIS_PORT=6379

# ─── Kafka ───
KAFKA_BOOTSTRAP_SERVERS=kafka:29092

# ─── Service Discovery / Config ───
EUREKA_URL=http://discovery-server:8761/eureka
CONFIG_SERVER_URL=http://config-server:8888

# ─── Observability ───
ZIPKIN_URL=http://zipkin:9411/api/v2/spans
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ─── Service URLs (workflow-service downstream) ───
DOCUMENT_SERVICE_URL=http://document-service:8082
AI_SERVICE_URL=http://ai-service:8083

# ─── Auth ───
# Generate with: openssl rand -base64 48 | tr -d '\n'
JWT_SECRET=replace-with-256-bit-or-longer-base64-secret-min-32-chars
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# ─── AI ───
GROQ_API_KEY=your-groq-api-key-here
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_MODEL=llama3-8b-8192

# Backward-compatible OpenAI vars (leave blank to use Groq)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=llama3-8b-8192

# ─── MinIO (object storage) ───
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=finsight-documents
MINIO_ENABLED=true

# ─── SMTP / Mailpit (local dev uses Mailpit on port 1025 automatically) ───
# Leave these blank to use Mailpit in Docker Compose.
# Set to real SMTP provider values in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# ─── Notifications ───
NOTIFICATION_FROM_ADDRESS=noreply@finsight.ai
# If set, emails are sent to this address for all workflow events
NOTIFICATION_TO_ADDRESS=
# Optional webhook URL for external integrations
NOTIFICATION_WEBHOOK_URL=

# ─── Frontend ───
VITE_API_BASE_URL=http://localhost:8080

# ─── CORS (api-gateway) ───
# Comma-separated list of allowed origins in production.
# Use http://localhost:3000 for local dev.
CORS_ALLOWED_ORIGINS=http://localhost:3000
