# FinSight AI - Environment Configuration Example

# JWT Security
JWT_SECRET=FinsightAISecretKeyMustBeAtLeast32BytesLongForHS256AlgorithmSecurity

# AI & LLM Integration (Groq API)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile

# PostgreSQL Storage
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=finsight_db

# MinIO Object Storage
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Redis Cache & Rate Limiter
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# Kafka Message Broker
KAFKA_BOOTSTRAP_SERVERS=kafka:9092

# Email & SMTP (Mailpit)
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=noreply@finsight.ai
SMTP_PASSWORD=
